#!/usr/bin/env python3
from pathlib import Path
import subprocess,sys
mode=sys.argv[1] if len(sys.argv)>1 else 'toggle'
if mode not in ('toggle','reduced','full'):raise SystemExit('Use toggle, reduced or full')
marker=Path.home()/'.local/state/omarchy/bone-grove/reduced-motion'
reduced=not marker.exists() if mode=='toggle' else mode=='reduced'
raise SystemExit(subprocess.call([str(Path.home()/'.local/bin/bone-grove'),'set','motion','0' if reduced else '1']))
