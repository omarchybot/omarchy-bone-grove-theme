#!/bin/bash
# Keep the native application id so Omarchy's idle and lock services track it.
if omarchy-toggle-enabled screensaver-off && [[ ${1:-} != force ]]; then exit 0; fi
if [[ $(omarchy-shell lock isLocked 2>/dev/null) == true ]]; then exit 0; fi
exec qs -p "$HOME/.config/omarchy/screensaver/org.omarchy.screensaver/shell.qml" -n -d
