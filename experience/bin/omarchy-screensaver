#!/usr/bin/env python3
"""Bone Grove: quiet native-terminal screensaver. Never replaces the session lock."""
from pathlib import Path
import datetime, json, math, os, select, shutil, signal, subprocess, sys, termios, time, tty
DIGITS = {
'0':['01110','11011','11011','11011','11011','11011','01110'],
'1':['00110','01110','00110','00110','00110','00110','01111'],
'2':['01110','11011','00011','00110','01100','11000','11111'],
'3':['11110','00011','00011','01110','00011','00011','11110'],
'4':['11011','11011','11011','11111','00011','00011','00011'],
'5':['11111','11000','11000','11110','00011','00011','11110'],
'6':['01110','11000','11000','11110','11011','11011','01110'],
'7':['11111','00011','00110','00110','01100','01100','01100'],
'8':['01110','11011','11011','01110','11011','11011','01110'],
'9':['01110','11011','11011','01111','00011','00011','01110'],
':':['000','000','010','000','010','000','000']}
BG=(12,18,14); WHITE=(233,231,222); SAGE=(145,166,135)
def frame(w,h,elapsed,now=None):
    now=now or datetime.datetime.now()
    cells=[[(' ',BG) for _ in range(w)] for _ in range(h)]
    def put(x,y,text,color):
        if 0<=y<h:
            for n,ch in enumerate(text):
                if 0<=x+n<w:cells[y][x+n]=(ch,color)
    # Low-contrast contour ribbons move through the lower third on a 90s cycle.
    for x in range(w):
        u=x/max(w,1)
        for line in range(4):
            y=int(h*.78+math.sin(u*4.8+elapsed*.07+line*.24)*h*.08+line*1.4)
            put(x,y,'·',(40+line*5,57+line*6,43+line*4))
    stamp=now.strftime('%H:%M')
    shift=round(math.sin(elapsed/65)*min(3,w//30))
    if w>=42 and h>=22:
        width=sum(len(DIGITS[c][0])+2 for c in stamp)-2
        top=max(2,h//2-6);left=(w-width)//2+shift
        for row in range(7):
            text='  '.join(''.join('█' if p=='1' else ' ' for p in DIGITS[c][row]) for c in stamp)
            put(left,top+row,text,WHITE)
        date=now.strftime('%A  ·  %B %d').replace(' 0',' ')
        put((w-len(date))//2+shift,top+10,date,SAGE)
    else:
        put((w-len(stamp))//2,h//2,stamp,WHITE)
    title='B O N E   G R O V E';put((w-len(title))//2, max(0,h//6),title,(94,115,87))
    hint='Move mouse or press any key';put((w-len(hint))//2,h-3,hint,(87,103,82))
    out=['\033[H'];last=None
    for y,row in enumerate(cells):
        for ch,color in row:
            if color!=last:out.append('\033[38;2;%d;%d;%dm'%color);last=color
            out.append(ch)
        if y<h-1:out.append('\r\n')
    return ''.join(out)
def focus_ok():
    try:
        p=subprocess.run(['hyprctl','activewindow','-j'],capture_output=True,text=True,timeout=.5)
        return json.loads(p.stdout).get('class')=='org.omarchy.screensaver'
    except (ValueError,OSError,subprocess.TimeoutExpired):return True

def main():
    if '--snapshot' in sys.argv:
        print(frame(100,36,20,datetime.datetime(2026,9,13,20,42)));return
    if not sys.stdin.isatty():return
    fd=sys.stdin.fileno(); previous=termios.tcgetattr(fd)
    def stop(*_):raise KeyboardInterrupt
    for sig in (signal.SIGTERM,signal.SIGHUP,signal.SIGINT):signal.signal(sig,stop)
    start=time.monotonic();check=start+2
    try:
        tty.setcbreak(fd)
        sys.stdout.write('\033[?1049h\033[?25l\033[?7l\033[48;2;12;18;14m\033[2J\033[?1003h\033[?1006h');sys.stdout.flush()
        while True:
            w,h=shutil.get_terminal_size((100,36));now=time.monotonic()
            sys.stdout.write(frame(w,h,0 if (Path.home()/".local/state/omarchy/bone-grove/reduced-motion").exists() else now-start));sys.stdout.flush()
            if select.select([fd],[],[],1/12)[0]:
                os.read(fd,1024)
                if now-start>.8:break
            if now>=check:
                check=now+1
                if not focus_ok():break
    except (KeyboardInterrupt,BrokenPipeError):pass
    finally:
        termios.tcsetattr(fd,termios.TCSADRAIN,previous)
        sys.stdout.write('\033[?1003l\033[?1006l\033[?7h\033[0m\033[?25h\033[?1049l');sys.stdout.flush()
if __name__=='__main__':main()
